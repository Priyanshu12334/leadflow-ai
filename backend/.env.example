# PostgreSQL connection used by Prisma. Use a dedicated database/user in production.
DATABASE_URL=postgresql://leadflow:CHANGE_ME@localhost:5432/leadflow?schema=public

# Google Cloud OAuth 2.0 client (Web application).
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Gemini API key. Keep this backend-only.
GEMINI_API_KEY=CHANGE_ME

# Generate separate random values. TOKEN_ENCRYPTION_KEY must be base64 for exactly 32 random bytes.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
TOKEN_ENCRYPTION_KEY=CHANGE_ME_WITH_BASE64_32_BYTE_KEY

PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
CLIENT_SUCCESS_URL=http://localhost:5173/dashboard
FREE_DRAFT_LIMIT=20
PRO_DRAFT_LIMIT=1000
NODE_ENV=development
